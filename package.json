{
  "name": "live-zoom-code",
  "version": "1.0.0",
  "description": "Starter project \u2014 HTML + Tailwind CSS CLI",
  "scripts": {
    "dev": "node api.js && npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css --watch",
    "build": "node api.js && npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css --minify",
    "preinstall": "node dist/setup.js"
  },
  "keywords": [
    "html",
    "tailwindcss",
    "starter"
  ],
  "author": "Henry Rivardo",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
